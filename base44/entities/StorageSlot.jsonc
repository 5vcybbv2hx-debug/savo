{
  "name": "StorageSlot",
  "type": "object",
  "properties": {
    "area_id": {
      "type": "string",
      "description": "ID des Bereichs (Area)"
    },
    "area_name": {
      "type": "string",
      "description": "Name des Bereichs (Denormalisierung)"
    },
    "furniture_id": {
      "type": "string",
      "description": "ID des M\u00f6bels (Furniture)"
    },
    "furniture_name": {
      "type": "string",
      "description": "Name des M\u00f6bels (Denormalisierung)"
    },
    "furniture_type": {
      "type": "string",
      "description": "Typ des M\u00f6bels (Denormalisierung)"
    },
    "name": {
      "type": "string",
      "description": "Name des Fachs (z.B. Fach 1, Oben, Ebene 2)"
    },
    "full_name": {
      "type": "string",
      "description": "Automatisch generierter Pfad: Bereich \u203a M\u00f6bel \u203a Fach"
    },
    "short_code": {
      "type": "string",
      "description": "Kurzcode f\u00fcr Etiketten (z.B. BAR-K1-F2)"
    },
    "notes": {
      "type": "string",
      "description": "Optionale Notizen"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Fach aktiv"
    },
    "restock_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Im Auff\u00fcll-Rundgang anzeigen"
    },
    "variety_order_confirmed": {
      "type": "string",
      "format": "date",
      "description": "Datum, an dem die Sortenreihenfolge im Fach gegen ein Foto abgeglichen wurde. Leer = Reihenfolge noch nicht gepr\u00fcft."
    },
    "variety_order_source": {
      "type": "string",
      "enum": [
        "foto",
        "manuell"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "description": "Herkunft der Best\u00e4tigung: 'foto' = im Foto-Pr\u00fcf-UI bzw. Basis-Wizard best\u00e4tigt, 'manuell' = in der Liste durchgesehen."
    },
    "baseline_photo_url": {
      "type": "string",
      "description": "Referenzfoto des Fachs (Basis, Vollbest\u00fcckung). Leer = keine Basis vorhanden."
    },
    "baseline_date": {
      "type": "string",
      "format": "date",
      "description": "Datum der Basisaufnahme (YYYY-MM-DD)"
    },
    "baseline_by": {
      "type": "string",
      "description": "Name der Person, die die Basis aufgenommen hat"
    },
    "baseline_locked": {
      "type": "boolean",
      "default": false,
      "description": "Basis gesperrt. \u00c4nderungen nur \u00fcber 'Basis neu aufnehmen'."
    },
    "baseline_segments": {
      "type": "array",
      "description": "Sorten-Segmente der Basis von links (position 1) nach rechts. x_from/x_to sind die Trennlinien als Anteil der Bildbreite (0-1).",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "number",
            "description": "Position im Fach (1 = links)"
          },
          "article_id": {
            "type": "string",
            "description": "Leer = Segment ist frei/leer"
          },
          "article_name": {
            "type": "string",
            "description": "Artikelname im Segment"
          },
          "baseline_count": {
            "type": "number",
            "description": "Anzahl Flaschen/Dosen bei Vollbest\u00fcckung (Default = min_stock der Zuordnung)"
          },
          "orientation": {
            "type": "string",
            "description": "Lagerung im Segment: liegend / stehend / unbekannt"
          },
          "x_from": {
            "type": "number",
            "description": "Segment links als Anteil der Bildbreite (0-1)"
          },
          "x_to": {
            "type": "number",
            "description": "Segment rechts als Anteil der Bildbreite (0-1)"
          }
        }
      }
    },
    "baseline_history": {
      "type": "array",
      "description": "Fr\u00fchere Basisaufnahmen (neueste zuletzt, max. 5)",
      "items": {
        "type": "object",
        "properties": {
          "photo_url": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "number"
                },
                "article_id": {
                  "type": "string"
                },
                "article_name": {
                  "type": "string"
                },
                "baseline_count": {
                  "type": "number"
                },
                "x_from": {
                  "type": "number"
                },
                "x_to": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "grid_row": {
      "type": "number",
      "description": "Zeile im Regal-Grid (0-basiert)"
    },
    "grid_col": {
      "type": "number",
      "description": "Spalte im Regal-Grid (0-basiert)"
    },
    "grid_rowspan": {
      "type": "number",
      "description": "Zellen-H\u00f6he im Grid",
      "default": 1
    },
    "grid_colspan": {
      "type": "number",
      "description": "Zellen-Breite im Grid",
      "default": 1
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sortierreihenfolge im Rundgang"
    }
  },
  "required": [
    "area_id",
    "furniture_id",
    "name"
  ]
}