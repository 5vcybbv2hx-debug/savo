{
  "name": "StorageSlot",
  "type": "object",
  "properties": {
    "area_id": {
      "type": "string",
      "description": "ID des Bereichs (Area)"
    },
    "area_name": {
      "type": "string",
      "description": "Name des Bereichs (Denormalisierung)"
    },
    "furniture_id": {
      "type": "string",
      "description": "ID des M\u00f6bels (Furniture)"
    },
    "furniture_name": {
      "type": "string",
      "description": "Name des M\u00f6bels (Denormalisierung)"
    },
    "furniture_type": {
      "type": "string",
      "description": "Typ des M\u00f6bels (Denormalisierung)"
    },
    "name": {
      "type": "string",
      "description": "Name des Fachs (z.B. Fach 1, Oben, Ebene 2)"
    },
    "full_name": {
      "type": "string",
      "description": "Automatisch generierter Pfad: Bereich \u203a M\u00f6bel \u203a Fach"
    },
    "short_code": {
      "type": "string",
      "description": "Kurzcode f\u00fcr Etiketten (z.B. BAR-K1-F2)"
    },
    "notes": {
      "type": "string",
      "description": "Optionale Notizen"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Fach aktiv"
    },
    "restock_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Im Auff\u00fcll-Rundgang anzeigen"
    },
    "variety_order_confirmed": {
      "type": "string",
      "format": "date",
      "description": "Datum, an dem die Sortenreihenfolge im Fach gegen ein Foto abgeglichen wurde. Leer = Reihenfolge noch nicht gepr\u00fcft."
    },
    "variety_order_source": {
      "type": "string",
      "enum": [
        "foto",
        "manuell"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "description": "Herkunft der Best\u00e4tigung: 'foto' = im Foto-Pr\u00fcf-UI best\u00e4tigt, 'manuell' = in der Liste durchgesehen."
    },
    "grid_row": {
      "type": "number",
      "description": "Zeile im Regal-Grid (0-basiert)"
    },
    "grid_col": {
      "type": "number",
      "description": "Spalte im Regal-Grid (0-basiert)"
    },
    "grid_rowspan": {
      "type": "number",
      "description": "Zellen-H\u00f6he im Grid",
      "default": 1
    },
    "grid_colspan": {
      "type": "number",
      "description": "Zellen-Breite im Grid",
      "default": 1
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sortierreihenfolge im Rundgang"
    }
  },
  "required": [
    "area_id",
    "furniture_id",
    "name"
  ]
}