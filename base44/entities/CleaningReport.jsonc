{
  "name": "CleaningReport",
  "type": "object",
  "properties": {
    "business_night_date": {
      "type": "string",
      "format": "date",
      "description": "Abend, zu dem die Schicht geh\u00f6rt (z. B. Freitag). Z\u00e4hlfenster: business_night_date 05:00 bis Folgetag 05:00 \u2014 ein Haken um 01:30 am Samstag z\u00e4hlt zur Freitags-Schicht."
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Datum des Berichts (= business_night_date)"
    },
    "week_end": {
      "type": "string",
      "format": "date",
      "description": "Ende des Berichtszeitraums (bei Nachtberichten identisch mit week_start)"
    },
    "required": {
      "type": "boolean",
      "default": true,
      "description": "true = Bedarfsnacht (Freitag, Samstag, Vorfeiertag, Abend vor Feiertag). false = Nacht ohne Bedarf \u2014 z\u00e4hlt nicht in Durchschnittsquote oder Warnungen."
    },
    "demand_reason": {
      "type": "string",
      "description": "Grund der Einstufung, z.B. Freitagnacht, Samstagnacht, Vorfeiertag \u2014 oder 'kein Bedarf'"
    },
    "report_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_title": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "completed_by": {
            "type": "string"
          },
          "completed_at": {
            "type": "string"
          }
        }
      },
      "description": "Berichtsdaten der im Schichtfenster erledigten Aufgaben"
    },
    "total_tasks": {
      "type": "number",
      "description": "Gesamtanzahl der in dieser Nacht f\u00e4lligen Aufgaben"
    },
    "completed_tasks": {
      "type": "number",
      "description": "Erledigte Aufgaben im Schichtfenster (05:00 bis 05:00)"
    },
    "completion_rate": {
      "type": "number",
      "description": "Erledigungsrate in Prozent (an N\u00e4chten ohne Bedarf nicht aussagekr\u00e4ftig)"
    }
  },
  "required": [
    "week_start",
    "week_end"
  ]
}