{
  "name": "CleaningReport",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Datum des Berichtstags (YYYY-MM-DD)"
    },
    "week_end": {
      "type": "string",
      "format": "date",
      "description": "Ende des Berichtszeitraums (bei Tagesberichten identisch mit week_start)"
    },
    "required": {
      "type": "boolean",
      "default": true,
      "description": "true = Bedarfstag (Samstag, Sonntag, Vorfeiertag, Feiertag oder Eventtag). false = Werktag ohne Bedarf \u2014 z\u00e4hlt nicht in Durchschnittsquote oder Warnungen."
    },
    "demand_reason": {
      "type": "string",
      "description": "Grund der Einstufung, z.B. Samstag, Sonntag, Feiertag \u2014 oder 'kein Bedarf' an Werktagen"
    },
    "report_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_title": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "completed_by": {
            "type": "string"
          },
          "completed_at": {
            "type": "string"
          }
        }
      },
      "description": "Berichtsdaten"
    },
    "total_tasks": {
      "type": "number",
      "description": "Gesamtanzahl der an diesem Tag f\u00e4lligen Aufgaben"
    },
    "completed_tasks": {
      "type": "number",
      "description": "Erledigte Aufgaben"
    },
    "completion_rate": {
      "type": "number",
      "description": "Erledigungsrate in Prozent (an Tagen ohne Bedarf nicht aussagekr\u00e4ftig)"
    }
  },
  "required": [
    "week_start",
    "week_end"
  ]
}