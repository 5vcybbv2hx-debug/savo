{
  "name": "LocalEvent",
  "type": "object",
  "properties": {
    "event_name": {
      "type": "string",
      "description": "Name des Events"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Startdatum des Events"
    },
    "event_end_date": {
      "type": "string",
      "format": "date",
      "description": "Enddatum (optional, bei mehrt\u00e4gigen Events)"
    },
    "category": {
      "type": "string",
      "enum": [
        "concert",
        "festival",
        "sports",
        "market",
        "community",
        "holiday",
        "other"
      ],
      "description": "Event-Kategorie"
    },
    "impact_level": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "description": "Auswirkung auf den Barbetrieb"
    },
    "location": {
      "type": "string",
      "description": "Veranstaltungsort"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung / Details"
    },
    "distance_km": {
      "type": "number",
      "description": "Entfernung zur Bar in km"
    },
    "staff_adjustment": {
      "type": "number",
      "description": "Manuelle Personal-Anpassung (+2 = mehr Personal, -1 = weniger)"
    },
    "bar_traffic_impact": {
      "type": "string",
      "enum": [
        "more",
        "less",
        "neutral"
      ],
      "default": "more",
      "description": "Einfluss auf den Barbetrieb: more/less/neutral"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "annual_fixed",
        "annual_floating",
        "irregular"
      ],
      "default": "none",
      "description": "Wiederholungsmuster: none=einmalig, annual_fixed=j\u00e4hrlich festes Datum, annual_floating=j\u00e4hrlich variabler Wochentag, irregular=unregelm\u00e4\u00dfig"
    },
    "recurrence_name": {
      "type": "string",
      "description": "Name der Wiederholungs-Serie (z.B. 'Balingen Stadtfest')"
    },
    "recurrence_base_month": {
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "description": "Basis-Monat f\u00fcr j\u00e4hrliche variable Wiederholung (1-12)"
    },
    "recurrence_week": {
      "type": "string",
      "enum": [
        "first",
        "second",
        "third",
        "fourth",
        "last"
      ],
      "description": "Woche im Monat f\u00fcr j\u00e4hrliche variable Wiederholung"
    },
    "recurrence_weekday": {
      "type": "number",
      "minimum": 0,
      "maximum": 6,
      "description": "Wochentag (0=So, 6=Sa) f\u00fcr j\u00e4hrliche variable Wiederholung"
    },
    "source": {
      "type": "string",
      "enum": [
        "manually",
        "auto"
      ],
      "default": "manually",
      "description": "Quelle: manually = manuell angelegt, auto = automatisch vorgeschlagen"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Event aktiv"
    }
  },
  "required": [
    "event_name",
    "event_date",
    "impact_level"
  ]
}