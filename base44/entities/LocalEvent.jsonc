{
  "name": "LocalEvent",
  "type": "object",
  "properties": {
    "event_name": {
      "type": "string",
      "description": "Name des Events"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Startdatum des Events"
    },
    "event_end_date": {
      "type": "string",
      "format": "date",
      "description": "Enddatum (optional, bei mehrt\u00e4gigen Events)"
    },
    "category": {
      "type": "string",
      "enum": [
        "concert",
        "festival",
        "sports",
        "market",
        "conference",
        "holiday",
        "other"
      ],
      "description": "Event-Kategorie"
    },
    "impact_level": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "description": "Auswirkung auf den Barbetrieb"
    },
    "location": {
      "type": "string",
      "description": "Veranstaltungsort"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung / Details"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Event aktiv"
    }
  },
  "required": [
    "event_name",
    "event_date",
    "impact_level"
  ]
}