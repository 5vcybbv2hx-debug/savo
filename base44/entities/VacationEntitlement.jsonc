{
  "name": "VacationEntitlement",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID des Mitarbeiters"
    },
    "employee_name": {
      "type": "string",
      "description": "Name des Mitarbeiters (Anzeige)"
    },
    "year": {
      "type": "number",
      "description": "Urlaubsjahr, z.B. 2027"
    },
    "days_entitlement": {
      "type": "number",
      "description": "Jahresanspruch in Tagen f\u00fcr dieses Jahr"
    },
    "days_carryover": {
      "type": "number",
      "description": "\u00dcbertrag aus dem Vorjahr in Tagen. Leer = wird automatisch aus dem Vorjahr berechnet; ein gesetzter Wert gewinnt immer."
    },
    "carryover_auto": {
      "type": "boolean",
      "default": true,
      "description": "Automatischen \u00dcbertrag aus dem Vorjahr erlauben. false = Resturlaub wird f\u00fcr diesen Mitarbeiter nicht ins Folgejahr \u00fcbertragen."
    },
    "carryover_expires_on": {
      "type": "string",
      "format": "date",
      "description": "NICHT MEHR BENUTZT. Der \u00dcbertrag verf\u00e4llt nicht. Feld bleibt nur aus Datenkompatibilit\u00e4t im Schema."
    },
    "notes": {
      "type": "string",
      "description": "Notizen zur Herkunft / Vereinbarung des Anspruchs"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Anspruch aktiv"
    }
  },
  "required": [
    "employee_id",
    "year",
    "days_entitlement"
  ]
}