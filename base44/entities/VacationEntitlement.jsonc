{
  "name": "VacationEntitlement",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID des Mitarbeiters"
    },
    "employee_name": {
      "type": "string",
      "description": "Name des Mitarbeiters (Anzeige)"
    },
    "year": {
      "type": "number",
      "description": "Urlaubsjahr, z.B. 2027"
    },
    "days_entitlement": {
      "type": "number",
      "description": "Jahresanspruch in Tagen f\u00fcr dieses Jahr"
    },
    "days_carryover": {
      "type": "number",
      "description": "\u00dcbertrag aus dem Vorjahr in Tagen. Leer = wird automatisch aus dem Vorjahr berechnet; ein gesetzter Wert gewinnt immer."
    },
    "carryover_expires_on": {
      "type": "string",
      "format": "date",
      "description": "Verfallsdatum des \u00dcbertrags (Hinweis in der Kontokarte). Standard bei automatischem \u00dcbertrag: 31. M\u00e4rz des Anspruchsjahres. Wird noch nicht hart durchgesetzt."
    },
    "notes": {
      "type": "string",
      "description": "Notizen zur Herkunft / Vereinbarung des Anspruchs"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Anspruch aktiv"
    }
  },
  "required": [
    "employee_id",
    "year",
    "days_entitlement"
  ]
}