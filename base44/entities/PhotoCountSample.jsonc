{
  "name": "PhotoCountSample",
  "type": "object",
  "properties": {
    "slot_id": {
      "type": "string",
      "description": "ID des StorageSlot (Fach)"
    },
    "slot_full_name": {
      "type": "string",
      "description": "Vollst\u00e4ndiger Fachpfad (Bereich \u203a M\u00f6bel \u203a Fach)"
    },
    "area_id": {
      "type": "string",
      "description": "ID des Bereichs (Area)"
    },
    "file_url": {
      "type": "string",
      "description": "URL des Fotos"
    },
    "baseline_used": {
      "type": "boolean",
      "default": false,
      "description": "Z\u00e4hlung lief gegen das Basis-Foto des Fachs (Delta-Z\u00e4hlung)"
    },
    "segments": {
      "type": "array",
      "description": "Sorten-Segmente in Fachreihenfolge (links \u2192 rechts). position 1 = linkes Segment.",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "number",
            "description": "Position im Fach (1 = links)"
          },
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "suggested_count": {
            "type": "number",
            "description": "Vorschlag des Modells in Flaschen/Dosen (0 = nichts erkannt)"
          },
          "confirmed_count": {
            "type": "number",
            "description": "Vom Menschen best\u00e4tigte Anzahl Flaschen/Dosen"
          },
          "delta": {
            "type": "number",
            "description": "confirmed_count \u2212 suggested_count (Korrektur des Menschen)"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "detected_total": {
      "type": "number",
      "description": "Summe aller vom Modell gez\u00e4hlten Flaschen/Dosen \u00fcber alle Sorten (nur Kontrollwert)"
    },
    "expected_articles": {
      "type": "array",
      "description": "Erwartete Artikel des Fachs in Fachreihenfolge",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "content_amount": {
            "type": "number"
          },
          "content_unit": {
            "type": "string"
          }
        }
      }
    },
    "model_raw_response": {
      "type": "object",
      "description": "Unver\u00e4nderte Antwort des Modells (JSON)"
    },
    "suggested_counts": {
      "type": "array",
      "description": "Vorschl\u00e4ge des Modells je Artikel (Flaschen/Dosen)",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "final_counts": {
      "type": "array",
      "description": "Vom Menschen best\u00e4tigte Mengen (Flaschen/Dosen)",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "opened_partial": {
            "type": "number"
          }
        }
      }
    },
    "photo_quality": {
      "type": "string",
      "description": "Einsch\u00e4tzung der Fotoqualit\u00e4t (gut, mittel, schlecht)"
    },
    "notes": {
      "type": "string",
      "description": "Notizen zur Z\u00e4hlung"
    },
    "model_hint": {
      "type": "string",
      "description": "Hinweis des Modells (falls vorhanden)"
    },
    "created_by_name": {
      "type": "string",
      "description": "Name der Person, die gez\u00e4hlt hat"
    }
  },
  "required": [
    "slot_id"
  ]
}