{
  "name": "Offer",
  "type": "object",
  "properties": {
    "offer_number": {
      "type": "string",
      "description": "Fortlaufende Angebotsnummer AN-YYYY-NNN"
    },
    "offer_date": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Gueltig bis (freibleibendes Angebot)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Externer Event",
        "Werbekostenzuschuss"
      ],
      "description": "Art des Aussenauftrags"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string",
      "description": "Vollstaendige Anschrift (komponiert aus Strasse/PLZ/Ort, fuer PDF). Legacy-Feld, wird beim Speichern aus den Einzelfeldern gesetzt."
    },
    "customer_street": {
      "type": "string",
      "description": "Strasse und Hausnummer"
    },
    "customer_postal_code": {
      "type": "string",
      "description": "Postleitzahl"
    },
    "customer_city": {
      "type": "string",
      "description": "Wohnort / Stadt"
    },
    "recipient_country": {
      "type": "string",
      "default": "Deutschland",
      "description": "Land des Empfaengers (fuer auslaendische Kunden/Lieferanten)"
    },
    "recipient_vat_id": {
      "type": "string",
      "description": "USt-IdNr. des Empfaengers (Pflicht bei innergemeinschaftlichen Lieferungen, \u00a714a UStG)"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Leistungsdatum (\u00a714 UStG-Pflichtangabe) \u2014 bei Zeitraum der Start"
    },
    "service_date_type": {
      "type": "string",
      "enum": [
        "Einzel",
        "Zeitraum"
      ],
      "default": "Einzel",
      "description": "Leistungsdatum-Typ: Einzel = ein Datum, Zeitraum = von/bis"
    },
    "service_date_end": {
      "type": "string",
      "format": "date",
      "description": "Leistungszeitraum Ende (nur bei service_date_type 'Zeitraum')"
    },
    "supplier_name": {
      "type": "string",
      "description": "WKZ: Lieferant/Brauerei als Empfaenger"
    },
    "supplier_id": {
      "type": "string"
    },
    "linked_event_id": {
      "type": "string",
      "description": "Optionaler Bezug zu einem Event"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "description": "Erwarteter Verbrauch (Kundenmenge) - Basis fuer VK-Summe"
          },
          "unit_price": {
            "type": "number",
            "description": "VK je Einheit (Verkaufspreis)"
          },
          "total": {
            "type": "number",
            "description": "quantity x unit_price (Umsatz erwartet)"
          },
          "category": {
            "type": "string",
            "description": "Kalkulations-Kategorie (Getraenke, Speisen, Personal, Sonstiges)"
          },
          "unit": {
            "type": "string",
            "description": "Einheit (z.B. 30-l-Fass, Glas, Std, Person)"
          },
          "quantity_provided": {
            "type": "number",
            "description": "Bereitgestellt (Reserve-Menge, fuer Umsatz max.)"
          },
          "ek_per_unit": {
            "type": "number",
            "description": "EK je Einheit (Einkaufspreis)"
          },
          "notes": {
            "type": "string",
            "description": "Hinweis (intern, nicht auf PDF)"
          }
        }
      },
      "description": "Angebotspositionen mit Kalkulation (EK/Verbrauch/Marge)"
    },
    "amount_net": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 19
    },
    "tax_amount": {
      "type": "number"
    },
    "amount_gross": {
      "type": "number"
    },
    "guests": {
      "type": "number",
      "description": "Erwartete Gaesteanzahl (Event-Kalkulation)"
    },
    "event_start_time": {
      "type": "string",
      "description": "Ausschank Beginn (HH:MM)"
    },
    "event_end_time": {
      "type": "string",
      "description": "Ausschank Ende (HH:MM)"
    },
    "staff_count": {
      "type": "number",
      "description": "Mitarbeiter extern (fuer Kalkulation)"
    },
    "wareneinsatz_total": {
      "type": "number",
      "description": "Summe Wareneinsatz (intern, aus Positionen berechnet)"
    },
    "revenue_expected_total": {
      "type": "number",
      "description": "Summe Umsatz erwartet (intern, aus Positionen berechnet)"
    },
    "revenue_max_total": {
      "type": "number",
      "description": "Summe Umsatz max. (intern, aus Positionen berechnet)"
    },
    "db_expected_total": {
      "type": "number",
      "description": "Summe Deckungsbeitrag erwartet (intern, aus Positionen berechnet)"
    },
    "db_marge_total": {
      "type": "number",
      "description": "DB-Marge gesamt (DB / Umsatz erwartet, intern)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Entwurf",
        "Gesendet",
        "Bestaetigt",
        "Abgelehnt",
        "Rechnung erstellt"
      ],
      "default": "Entwurf"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "notes_public": {
      "type": "boolean",
      "default": false,
      "description": "Wenn true, werden die Notizen auf dem Angebots-PDF fuer den Empfaenger sichtbar angezeigt"
    },
    "converted_invoice_id": {
      "type": "string",
      "description": "ID der erstellten Rechnung nach Konvertierung"
    }
  },
  "required": [
    "offer_date",
    "customer_name",
    "amount_gross"
  ]
}