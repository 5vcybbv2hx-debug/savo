{
  "name": "Offer",
  "type": "object",
  "properties": {
    "offer_number": {
      "type": "string",
      "description": "Fortlaufende Angebotsnummer AN-YYYY-NNN"
    },
    "offer_date": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "G\u00fcltig bis (freibleibendes Angebot)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Externer Event",
        "Werbekostenzuschuss"
      ],
      "description": "Art des Au\u00dfenauftrags"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string",
      "description": "Vollst\u00e4ndige Anschrift (komponiert aus Stra\u00dfe/PLZ/Ort, f\u00fcr PDF). Legacy-Feld, wird beim Speichern aus den Einzelfeldern gesetzt."
    },
    "customer_street": {
      "type": "string",
      "description": "Stra\u00dfe und Hausnummer"
    },
    "customer_postal_code": {
      "type": "string",
      "description": "Postleitzahl"
    },
    "customer_city": {
      "type": "string",
      "description": "Wohnort / Stadt"
    },
    "recipient_country": {
      "type": "string",
      "default": "Deutschland",
      "description": "Land des Empf\u00e4ngers (f\u00fcr ausl\u00e4ndische Kunden/Lieferanten)"
    },
    "recipient_vat_id": {
      "type": "string",
      "description": "USt-IdNr. des Empf\u00e4ngers (Pflicht bei innergemeinschaftlichen Lieferungen, \u00a714a UStG)"
    },
    "supplier_name": {
      "type": "string",
      "description": "WKZ: Lieferant/Brauerei als Empf\u00e4nger"
    },
    "supplier_id": {
      "type": "string"
    },
    "linked_event_id": {
      "type": "string",
      "description": "Optionaler Bezug zu einem Event"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "amount_net": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 19
    },
    "tax_amount": {
      "type": "number"
    },
    "amount_gross": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Entwurf",
        "Gesendet",
        "Best\u00e4tigt",
        "Abgelehnt",
        "Rechnung erstellt"
      ],
      "default": "Entwurf"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "notes_public": {
      "type": "boolean",
      "default": false,
      "description": "Wenn true, werden die Notizen auf dem Angebots-PDF f\u00fcr den Empf\u00e4nger (Lieferant/Brauerei/Kunde) sichtbar angezeigt"
    },
    "converted_invoice_id": {
      "type": "string",
      "description": "ID der erstellten Rechnung nach Konvertierung"
    }
  },
  "required": [
    "offer_date",
    "customer_name",
    "amount_gross"
  ]
}