{
  "name": "StorageAssignment",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID des Artikels (aus Article-Entity)"
    },
    "article_name": {
      "type": "string",
      "description": "Name des Artikels (f\u00fcr schnellen Zugriff)"
    },
    "storage_slot_id": {
      "type": "string",
      "description": "ID des Lagerplatzes (StorageSlot)"
    },
    "slot_full_name": {
      "type": "string",
      "description": "Full Name des Lagerplatzes"
    },
    "quantity": {
      "type": "number",
      "description": "Aktuelle Menge am Lagerplatz"
    },
    "min_stock": {
      "type": "number",
      "description": "Mindestbestand"
    },
    "max_stock": {
      "type": "number",
      "description": "Maximaler Bestand"
    },
    "unit": {
      "type": "string",
      "description": "Einheit (St\u00fcck, Liter, kg, etc.)"
    },
    "storage_orientation": {
      "type": "string",
      "enum": [
        "liegend",
        "stehend",
        "unbekannt"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "unbekannt",
      "description": "Lagerung im Fach: liegend oder stehend. Wird der Foto-Z\u00e4hlung als Kontext mitgegeben."
    },
    "notes": {
      "type": "string",
      "description": "Notizen zur Lagerung"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Zuordnung aktiv"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Reihenfolge der Artikel-Zuordnung innerhalb eines Faches"
    }
  },
  "required": [
    "article_id",
    "storage_slot_id"
  ]
}