{
  "name": "DisplaySlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Haupt\u00fcberschrift der Slide"
    },
    "subtitle": {
      "type": "string",
      "description": "Unterzeile / Kurzbeschreibung"
    },
    "body_text": {
      "type": "string",
      "description": "L\u00e4ngerer Flie\u00dftext (optional)"
    },
    "slide_type": {
      "type": "string",
      "enum": [
        "announcement",
        "event",
        "drink_special",
        "poster",
        "image_only",
        "countdown"
      ],
      "description": "Slide-Typ bestimmt das Layout. 'poster' zeigt ausschlie\u00dflich image_url formatf\u00fcllend; announcement/event/drink_special zeigen bei gesetztem image_url ebenfalls nur das Bild."
    },
    "image_url": {
      "type": "string",
      "description": "Bild-URL (optional) \u2014 wird bei poster formatf\u00fcllend gezeigt"
    },
    "accent_color": {
      "type": "string",
      "enum": [
        "amber",
        "blue",
        "green",
        "red",
        "purple",
        "pink",
        "cyan"
      ],
      "description": "Akzentfarbe"
    },
    "background_theme": {
      "type": "string",
      "enum": [
        "auto",
        "germany",
        "american_football",
        "soccer",
        "disco",
        "music",
        "party",
        "cocktail",
        "beer",
        "fireworks",
        "summer",
        "christmas",
        "halloween",
        "love",
        "food",
        "default"
      ],
      "default": "auto",
      "description": "Hintergrund-Animation (auto = anhand Titel erkannt)"
    },
    "cta_text": {
      "type": "string",
      "description": "Call-to-Action Text"
    },
    "event_date": {
      "type": "string",
      "description": "Datum f\u00fcr Events/Countdowns (ISO)"
    },
    "event_time": {
      "type": "string",
      "description": "Uhrzeit (z.B. '20:00')"
    },
    "manual_override": {
      "type": "boolean",
      "description": "Manuell bearbeitet: Event-Sync \u00fcberschreibt Texte nicht mehr"
    },
    "public_event": {
      "type": "boolean",
      "default": false,
      "description": "\u00d6ffentliche Event-Detailseite (/Event/:id) + QR-Code auf dem Display aktiviert. Nur dann ist die Slide \u00f6ffentlich abrufbar (Function getPublicEvent pr\u00fcft dieses Flag)."
    },
    "location": {
      "type": "string",
      "description": "Veranstaltungsort (wird auf Slide + \u00f6ffentlicher Event-Seite angezeigt)"
    },
    "event_end_date": {
      "type": "string",
      "description": "Optionales Enddatum bei mehrt\u00e4gigen Events"
    },
    "event_end_time": {
      "type": "string",
      "description": "Optionale Endzeit"
    },
    "price_info": {
      "type": "string",
      "description": "Preis-Info (z.B. '4,50 \u20ac / Glas')"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "show_from": {
      "type": "string",
      "description": "Anzeige ab (ISO DateTime)"
    },
    "show_until": {
      "type": "string",
      "description": "Anzeige bis (ISO DateTime)"
    },
    "duration_seconds": {
      "type": "number",
      "default": 8,
      "description": "Anzeigedauer in Sekunden"
    }
  },
  "required": [
    "title",
    "slide_type"
  ]
}