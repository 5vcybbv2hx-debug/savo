{
  "name": "DisplaySlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Haupt\u00fcberschrift der Slide"
    },
    "subtitle": {
      "type": "string",
      "description": "Unterzeile"
    },
    "body_text": {
      "type": "string",
      "description": "Flie\u00dftext (optional)"
    },
    "slide_type": {
      "type": "string",
      "enum": [
        "announcement",
        "event",
        "drink_special",
        "image_only",
        "countdown"
      ],
      "description": "Art der Slide"
    },
    "image_url": {
      "type": "string",
      "description": "Bild-URL"
    },
    "accent_color": {
      "type": "string",
      "enum": [
        "amber",
        "blue",
        "green",
        "red",
        "purple",
        "pink",
        "cyan"
      ],
      "description": "Akzentfarbe"
    },
    "cta_text": {
      "type": "string",
      "description": "Call-to-Action Text"
    },
    "event_date": {
      "type": "string",
      "description": "Event-Datum (ISO oder freitext)"
    },
    "event_time": {
      "type": "string",
      "description": "Event-Uhrzeit"
    },
    "price_info": {
      "type": "string",
      "description": "Preisinformation"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Aktiv"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sortierreihenfolge"
    },
    "show_from": {
      "type": "string",
      "description": "Anzeige ab (ISO-Datum/Zeit)"
    },
    "show_until": {
      "type": "string",
      "description": "Anzeige bis (ISO-Datum/Zeit)"
    },
    "duration_seconds": {
      "type": "number",
      "default": 8,
      "description": "Anzeigedauer in Sekunden"
    }
  },
  "required": [
    "title",
    "slide_type"
  ]
}