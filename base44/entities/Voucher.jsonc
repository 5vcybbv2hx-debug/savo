{
  "name": "Voucher",
  "type": "object",
  "properties": {
    "voucher_number": {
      "type": "number",
      "description": "Kassen-Gutscheinnummer"
    },
    "access_token": {
      "type": "string",
      "description": "6-stelliger Zugriffs-Code (A-Z ohne I/O, 2-9) f\u00fcr den QR-Code auf dem Beleg \u2014 macht die \u00f6ffentliche Gutschein-URL nicht ratbar"
    },
    "holder_name": {
      "type": "string",
      "description": "Name des K\u00e4ufers/Guthabenkarten-Inhabers (z.B. bei gro\u00dfen Betr\u00e4gen auf Rechnung)"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Ausstellungsdatum"
    },
    "original_value": {
      "type": "number",
      "description": "Urspr\u00fcnglicher Gutscheinwert in Euro"
    },
    "remaining_value": {
      "type": "number",
      "description": "Aktueller Restbetrag in Euro"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bar",
        "ec",
        "ueberweisung",
        "bar_ec",
        "rabatt_ueberweisung"
      ],
      "description": "Zahlungsart bei Ausstellung"
    },
    "status": {
      "type": "string",
      "enum": [
        "offen",
        "teilweise_eingel\u00f6st",
        "eingel\u00f6st",
        "ung\u00fcltig"
      ],
      "description": "Status des Gutscheins"
    },
    "source": {
      "type": "string",
      "description": "Herkunft: kassen_import_2026_10, manual, flatpay_import"
    },
    "notes": {
      "type": "string",
      "description": "Notizen"
    }
  },
  "required": [
    "voucher_number",
    "issue_date",
    "original_value",
    "remaining_value",
    "status"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}