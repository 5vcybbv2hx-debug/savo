{
  "name": "RolePreset",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Name der Vorlage (z. B. Aushilfe, Barkeeper)"
    },
    "description": {
      "type": "string",
      "description": "Kurzbeschreibung, was die Vorlage umfasst"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Rechte der Vorlage als Schl\u00fcssel-Wert-Paare (Permission-Key \u2192 true/false bzw. none/view/edit)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Reihenfolge in der Rollen-Reihe"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Eingebaute Vorlage \u2014 darf nicht gel\u00f6scht werden, nur bearbeitet"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Vorlage wird in der Rollen-Reihe angezeigt"
    }
  },
  "required": [
    "display_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}