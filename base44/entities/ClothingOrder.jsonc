{
  "name": "ClothingOrder",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Employee-Entity-ID des Bestellers"
    },
    "employee_name": {
      "type": "string",
      "description": "Anzeigename des Bestellers"
    },
    "item": {
      "type": "string",
      "enum": [
        "zshirt",
        "pulli"
      ],
      "description": "Bestellter Artikel: Z-Shirt oder Pulli"
    },
    "size": {
      "type": "string",
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL",
        "XXL",
        "XXXL"
      ],
      "description": "Konfektionsgr\u00f6\u00dfe"
    },
    "quantity": {
      "type": "integer",
      "description": "Bestellmenge (1-5)"
    },
    "round_id": {
      "type": "string",
      "description": "ID der ClothingRound, zu der die Bestellung geh\u00f6rt"
    }
  },
  "required": [
    "employee_id",
    "item",
    "size"
  ]
}