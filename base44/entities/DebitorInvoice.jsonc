{
  "name": "DebitorInvoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string",
      "description": "Vollst\u00e4ndige Anschrift (komponiert aus Stra\u00dfe/PLZ/Ort, f\u00fcr PDF). Legacy-Feld, wird beim Speichern aus den Einzelfeldern gesetzt."
    },
    "customer_street": {
      "type": "string",
      "description": "Stra\u00dfe und Hausnummer"
    },
    "customer_postal_code": {
      "type": "string",
      "description": "Postleitzahl"
    },
    "customer_city": {
      "type": "string",
      "description": "Wohnort / Stadt"
    },
    "amount_net": {
      "type": "number"
    },
    "amount_gross": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "offen",
        "teilbezahlt",
        "bezahlt",
        "\u00fcberf\u00e4llig"
      ],
      "default": "offen"
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "notes_public": {
      "type": "boolean",
      "default": false,
      "description": "Wenn true, werden die Notizen auf dem Rechnungs-PDF f\u00fcr den Empf\u00e4nger (Lieferant/Brauerei/Kunde) sichtbar angezeigt"
    },
    "linked_event_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Externer Event",
        "Werbekostenzuschuss"
      ],
      "description": "Art des Au\u00dfenauftrags: Bar-Service bei externem Event oder Werbekostenzuschuss von Lieferant/Brauerei"
    },
    "doc_status": {
      "type": "string",
      "enum": [
        "Entwurf",
        "Gesendet",
        "Storniert"
      ],
      "default": "Entwurf",
      "description": "Dokumentenstatus \u2014 Entwurf wird nicht in den DATEV-Export aufgenommen"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      },
      "description": "Rechnungspositionen (Beschreibung, Menge, Einzelpreis, Summe)"
    },
    "supplier_name": {
      "type": "string",
      "description": "WKZ: Lieferant/Brauerei als Rechnungsempf\u00e4nger"
    },
    "supplier_id": {
      "type": "string"
    },
    "offer_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung zum Ursprungs-Angebot"
    },
    "offer_number": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Leistungsdatum (\u00a714 UStG-Pflichtangabe) \u2014 bei Zeitraum der Start"
    },
    "service_date_type": {
      "type": "string",
      "enum": [
        "Einzel",
        "Zeitraum"
      ],
      "default": "Einzel",
      "description": "Leistungsdatum-Typ: Einzel = ein Datum, Zeitraum = von/bis"
    },
    "service_date_end": {
      "type": "string",
      "format": "date",
      "description": "Leistungszeitraum Ende (nur bei service_date_type 'Zeitraum')"
    },
    "datev_account": {
      "type": "string",
      "description": "Erl\u00f6skonto SKR03 \u2014 Standard 8000 (Events) / 8035 (WKZ)"
    }
  },
  "required": [
    "invoice_date",
    "customer_name",
    "amount_gross"
  ]
}