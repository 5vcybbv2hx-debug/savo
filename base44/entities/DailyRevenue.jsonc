{
  "name": "DailyRevenue",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Datum des Z-Abschlags"
    },
    "revenue": {
      "type": "number",
      "description": "Tagesumsatz in Euro (Gesamt)"
    },
    "revenue_cash": {
      "type": "number",
      "description": "Umsatz Bar (Bargeld)"
    },
    "revenue_ec": {
      "type": "number",
      "description": "Umsatz EC-Karte"
    },
    "vat": {
      "type": "number",
      "description": "Umsatzsteuer in Euro"
    },
    "own_consumption": {
      "type": "number",
      "description": "Eigenbedarf in Euro"
    },
    "manual_labor_cost_daily": {
      "type": "number",
      "description": "Manuelle Personalkosten Aushilfen (\u00fcberschreibt berechnete Werte)"
    },
    "manual_labor_cost_fulltime": {
      "type": "number",
      "description": "Manuelle Personalkosten Festangestellte (\u00fcberschreibt berechnete Werte)"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL zur hochgeladenen Z-Abschlag PDF"
    },
    "notes": {
      "type": "string",
      "description": "Notizen zum Z-Abschlag"
    },
    "weather_temp_max": {
      "type": "number",
      "description": "H\u00f6chsttemperatur (\u00b0C) \u2014 automatisch via Open-Meteo"
    },
    "weather_temp_mean": {
      "type": "number",
      "description": "Durchschnittstemperatur (\u00b0C) \u2014 automatisch via Open-Meteo"
    },
    "weather_precipitation": {
      "type": "number",
      "description": "Niederschlag (mm) \u2014 automatisch via Open-Meteo"
    },
    "weather_code": {
      "type": "number",
      "description": "WMO Weather Code \u2014 automatisch via Open-Meteo"
    },
    "weather_description": {
      "type": "string",
      "description": "Klartext Wetter (z.B. 'Sonnig', 'Regen') \u2014 automatisch"
    },
    "is_holiday": {
      "type": "boolean",
      "description": "Feiertag \u2014 automatisch gesetzt"
    },
    "is_school_vacation": {
      "type": "boolean",
      "description": "Schulferien Berlin \u2014 automatisch gesetzt"
    },
    "local_event_impact": {
      "type": "string",
      "enum": [
        "none",
        "small",
        "medium",
        "large"
      ],
      "description": "Auswirkung externer Events auf den Tag"
    },
    "staff_count": {
      "type": "number",
      "description": "Anzahl Mitarbeiter an diesem Tag (automatisch aus Schichten)"
    },
    "labor_cost_total": {
      "type": "number",
      "description": "Gesamte Personalkosten des Tages (automatisch berechnet)"
    },
    "busyness_level": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Betriebsamkeit: 1=Ruhig, 2=Entspannt, 3=Normal, 4=Lebhaft, 5=Stark \u2014 manuell beim Tagesabschluss"
    },
    "is_holiday_eve": {
      "type": "boolean",
      "description": "Tag vor Feiertag \u2014 oft Partyabend (Silvester, 30.04., 24.12., etc.)"
    },
    "is_bridge_day": {
      "type": "boolean",
      "description": "Br\u00fcckentag \u2014 Werktag zwischen Feiertag und Wochenende"
    },
    "season": {
      "type": "string",
      "enum": [
        "winter",
        "spring",
        "summer",
        "autumn"
      ],
      "description": "Jahreszeit \u2014 automatisch gesetzt f\u00fcr saisonale Gewichtung"
    },
    "holiday_name": {
      "type": "string",
      "description": "Name des Feiertags (automatisch gesetzt, z.B. 'Silvester', 'Karfreitag')"
    },
    "source": {
      "type": "string",
      "enum": [
        "tagesabschluss",
        "zabschlag_import",
        "manual"
      ],
      "description": "Herkunft des Eintrags: tagesabschluss (regul\u00e4rer Tagesabschluss in der App), zabschlag_import (automatischer Import der Z-Abschlags-Historie), manual (manuell nachgetragen)"
    }
  },
  "required": [
    "date",
    "revenue"
  ]
}