{
  "name": "DailyRevenue",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Datum des Z-Abschlags"
    },
    "revenue": {
      "type": "number",
      "description": "Tagesumsatz in Euro (Gesamt)"
    },
    "revenue_cash": {
      "type": "number",
      "description": "Umsatz Bar (Bargeld)"
    },
    "revenue_ec": {
      "type": "number",
      "description": "Umsatz EC-Karte"
    },
    "vat": {
      "type": "number",
      "description": "Umsatzsteuer in Euro"
    },
    "own_consumption": {
      "type": "number",
      "description": "Eigenbedarf in Euro"
    },
    "manual_labor_cost_daily": {
      "type": "number",
      "description": "Manuelle Personalkosten Aushilfen (überschreibt berechnete Werte)"
    },
    "manual_labor_cost_fulltime": {
      "type": "number",
      "description": "Manuelle Personalkosten Festangestellte (überschreibt berechnete Werte)"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL zur hochgeladenen Z-Abschlag PDF"
    },
    "notes": {
      "type": "string",
      "description": "Notizen zum Z-Abschlag"
    },
    "weather_temp_max": {
      "type": "number",
      "description": "Höchsttemperatur (°C) — automatisch via Open-Meteo"
    },
    "weather_temp_mean": {
      "type": "number",
      "description": "Durchschnittstemperatur (°C) — automatisch via Open-Meteo"
    },
    "weather_precipitation": {
      "type": "number",
      "description": "Niederschlag (mm) — automatisch via Open-Meteo"
    },
    "weather_code": {
      "type": "number",
      "description": "WMO Weather Code — automatisch via Open-Meteo"
    },
    "weather_description": {
      "type": "string",
      "description": "Klartext Wetter (z.B. 'Sonnig', 'Regen') — automatisch"
    },
    "is_holiday": {
      "type": "boolean",
      "description": "Feiertag — automatisch gesetzt"
    },
    "is_school_vacation": {
      "type": "boolean",
      "description": "Schulferien Berlin — automatisch gesetzt"
    },
    "local_event_impact": {
      "type": "string",
      "enum": [
        "none",
        "small",
        "medium",
        "large"
      ],
      "description": "Auswirkung externer Events auf den Tag"
    },
    "staff_count": {
      "type": "number",
      "description": "Anzahl Mitarbeiter an diesem Tag (automatisch aus Schichten)"
    },
    "labor_cost_total": {
      "type": "number",
      "description": "Gesamte Personalkosten des Tages (automatisch berechnet)"
    },
    "busyness_level": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Betriebsamkeit: 1=Ruhig, 2=Entspannt, 3=Normal, 4=Lebhaft, 5=Stark — manuell beim Tagesabschluss"
    },
    "is_holiday_eve": {
      "type": "boolean",
      "description": "Tag vor Feiertag — oft Partyabend (Silvester, 30.04., 24.12., etc.)"
    },
    "is_bridge_day": {
      "type": "boolean",
      "description": "Brückentag — Werktag zwischen Feiertag und Wochenende"
    },
    "season": {
      "type": "string",
      "enum": [
        "winter",
        "spring",
        "summer",
        "autumn"
      ],
      "description": "Jahreszeit — automatisch gesetzt für saisonale Gewichtung"
    },
    "holiday_name": {
      "type": "string",
      "description": "Name des Feiertags (automatisch gesetzt, z.B. 'Silvester', 'Karfreitag')"
    }
  },
  "required": [
    "date",
    "revenue"
  ]
}