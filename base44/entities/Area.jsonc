{
  "name": "Area",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name des Bereichs (z.B. Theke Nichtraucher, Theke Raucher, Keller)"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung"
    },
    "area_type": {
      "type": "string",
      "enum": [
        "theke",
        "lager",
        "sonstiges"
      ],
      "default": "theke",
      "description": "Typ: theke = Auff\u00fcll-Bereich, lager = Lagerraum, sonstiges"
    },
    "color": {
      "type": "string",
      "description": "Tailwind-Farbklasse f\u00fcr UI (z.B. blue, green, amber)"
    },
    "icon": {
      "type": "string",
      "description": "Lucide-Icon Name (z.B. Beer, Coffee, Package)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Bereich aktiv"
    },
    "sort_order": {
      "type": "number",
      "description": "Sortierreihenfolge",
      "default": 0
    },
    "restock_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Im Auff\u00fcll-Rundgang anzeigen"
    }
  },
  "required": [
    "name"
  ]
}