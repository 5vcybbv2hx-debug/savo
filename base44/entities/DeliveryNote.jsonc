{
  "name": "DeliveryNote",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string",
      "description": "Lieferant laut Lieferschein (best\u00e4tigt)"
    },
    "supplier_id": {
      "type": "string",
      "description": "Referenz auf Supplier (optional, wenn zugeordnet)"
    },
    "delivery_note_number": {
      "type": "string",
      "description": "Lieferschein-Nummer"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Lieferdatum (YYYY-MM-DD)"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "lieferschein",
        "leergut",
        "rechnung",
        "unbekannt"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "gray"
      ],
      "default": "lieferschein",
      "description": "Erkannter Dokumenttyp. 'leergut' = nur R\u00fcckgabe, wird nicht als Wareneingang gebucht."
    },
    "file_url": {
      "type": "string",
      "description": "URL des hochgeladenen Fotos/PDF des Lieferscheins (erste Seite)"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs aller Seiten des Belegs in Seitenreihenfolge (Seite 1 zuerst). Leer bei Altbest\u00e4nden mit nur file_url."
    },
    "page_count": {
      "type": "number",
      "description": "Anzahl der Seiten des Belegs (1 bei einseitigen Lieferscheinen)"
    },
    "positions": {
      "type": "array",
      "description": "Erkannte und best\u00e4tigte Warenpositionen (gebucht)",
      "items": {
        "type": "object",
        "properties": {
          "raw_text": {
            "type": "string",
            "description": "Bezeichnung wie auf dem Lieferschein"
          },
          "article_name": {
            "type": "string",
            "description": "Zugeordneter Artikelname"
          },
          "article_id": {
            "type": "string",
            "description": "Referenz auf Article"
          },
          "supplier_article_number": {
            "type": "string",
            "description": "Artikelnummer des Lieferanten laut Beleg (z. B. 38182)"
          },
          "match_source": {
            "type": "string",
            "enum": [
              "artikelnummer",
              "name",
              "manuell"
            ],
            "description": "Herkunft der Artikelzuordnung. 'manuell' = vom Mitarbeiter gew\u00e4hlt (l\u00f6st den Lernmodus aus)."
          },
          "quantity": {
            "type": "number",
            "description": "Liefermenge in Gebinden (Alias zu quantity_packages)"
          },
          "quantity_packages": {
            "type": "number",
            "description": "Liefermenge in Gebinden, z. B. 1 bei 1 Kasten"
          },
          "unit_code": {
            "type": "string",
            "description": "Einheiten-K\u00fcrzel laut Beleg: Ka, Fa, Do, Fl, Ba, St"
          },
          "quantity_units": {
            "type": "number",
            "description": "In Lagereinheiten umgerechnete Menge (quantity_packages \u00d7 units_per_packaging; bei Fass = Anzahl F\u00e4sser)"
          },
          "unit": {
            "type": "string",
            "description": "Einheit: Kasten, Fass, Dose, Flasche, Bag in Box, St\u00fcck, kg"
          },
          "packaging": {
            "type": "string",
            "description": "Gebindeart laut Beleg"
          },
          "unit_size": {
            "type": "number",
            "description": "Einzeleinheiten pro Gebinde (sonst 1)"
          },
          "units_per_packaging": {
            "type": "number",
            "description": "St\u00fcck pro Gebinde aus der Spalte Geb."
          },
          "content_amount": {
            "type": "number",
            "description": "F\u00fcllmenge je Einheit laut Beleg (z. B. 0.7 bei 0,7 l). Keine Preisangabe."
          },
          "content_unit": {
            "type": "string",
            "description": "Einheit der F\u00fcllmenge: l, ml, cl, g, kg"
          },
          "page_number": {
            "type": "number",
            "description": "Seite des Belegs, auf der die Position steht (1-basiert)"
          },
          "unit_price": {
            "type": "number",
            "description": "EK netto pro Einheit \u2014 nur wenn auf dem Beleg ausdr\u00fccklich als Preis gekennzeichnet, sonst null"
          },
          "line_total": {
            "type": "number",
            "description": "Zeilensumme netto \u2014 nur bei vorhandenem Preis, sonst null"
          },
          "shopping_item_id": {
            "type": "string",
            "description": "Zugeordnete offene Bestellposition"
          },
          "booked": {
            "type": "boolean",
            "default": false,
            "description": "Wurde die Position gebucht?"
          },
          "booked_units": {
            "type": "number",
            "description": "Tats\u00e4chlich gebuchte Einzeleinheiten"
          }
        }
      }
    },
    "return_positions": {
      "type": "array",
      "description": "Leergut/R\u00fcckgabe \u2014 nur informativ gespeichert, kein Bestand und kein Preis",
      "items": {
        "type": "object",
        "properties": {
          "raw_text": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "supplier_article_number": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "description": "R\u00fcckgabemenge in Gebinden"
          },
          "unit_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "units_per_packaging": {
            "type": "number"
          },
          "quantity_units": {
            "type": "number"
          },
          "content_amount": {
            "type": "number"
          },
          "content_unit": {
            "type": "string"
          },
          "page_number": {
            "type": "number"
          }
        }
      }
    },
    "return_positions_count": {
      "type": "number",
      "description": "Anzahl der Leergut-/R\u00fcckgabezeilen (nicht gebucht)"
    },
    "positions_count": {
      "type": "number",
      "description": "Anzahl der Warenpositionen"
    },
    "total_net": {
      "type": "number",
      "description": "Summe netto in Euro \u2014 null, wenn auf dem Beleg keine Preise stehen"
    },
    "status": {
      "type": "string",
      "enum": [
        "entwurf",
        "gebucht"
      ],
      "enumColors": [
        "gray",
        "green"
      ],
      "default": "entwurf",
      "description": "Bearbeitungsstand"
    },
    "booking_summary": {
      "type": "string",
      "description": "Zusammenfassung der Buchung (Positionen, Preis\u00fcbernahmen, abgeschlossene Bestellungen)"
    },
    "notes": {
      "type": "string",
      "description": "Notizen"
    }
  },
  "required": [
    "supplier_name"
  ]
}