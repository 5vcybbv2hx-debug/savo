{
  "name": "Push: To-Do erledigt \u2192 Manager",
  "description": "Sendet Push an Manager wenn ein To-Do als erledigt markiert wird.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"erledigt\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TodoItem"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_to_do_erledigt_manager",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTodoCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTodoCompleted"
  }
}