{
  "name": "Push: Zeiterfassung genehmigt \u2192 Mitarbeiter",
  "description": "Sendet Push an Mitarbeiter wenn Zeiterfassung genehmigt wird.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"genehmigt\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TimeEntry"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_zeiterfassung_genehmigt_mitarbeiter",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTimeEntryApproved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTimeEntryApproved"
  }
}