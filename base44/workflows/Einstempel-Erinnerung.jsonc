{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "einstempel_erinnerung",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyClockInReminders",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "Europe/Berlin",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-10-18T19:50:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Alle 10 Minuten: Push-Erinnerung ~30 Min vor Schichtbeginn, wenn der Mitarbeiter noch nicht eingestempelt ist",
  "name": "Einstempel-Erinnerung"
}