{
  "name": "Push: Abwesenheitsanfrage \u2192 Manager",
  "description": "Sendet Push an alle Manager wenn eine neue Abwesenheitsanfrage eingeht.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "UnavailabilityRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_abwesenheitsanfrage_manager",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onUnavailabilityRequest",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onUnavailabilityRequest"
  }
}